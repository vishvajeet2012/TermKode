# TermKode runs locally and calls AI providers with your own API key.
# Keys are usually added from inside the app with /providers, which stores them
# in ~/.termkode/config.json. These variables are an alternative for CI,
# containers, or shared setups.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
LLAMA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
ZAI_API_KEY=

# Optional: local AI endpoint, only needed when it is not on a default port.
# Ollama, LM Studio, llama.cpp, vLLM, and Jan are detected automatically.
LOCAL_AI_BASE_URL=

# Optional: directory used for sessions and settings (default: ~/.termkode)
TERMKODE_HOME=

# Optional: use a separately running TermKode server instead of the built-in one
API_URL=
